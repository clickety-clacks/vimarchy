#!/usr/bin/env bash

set -euo pipefail

snapshot_file=${1:?snapshot path required}
assignments_file=${2:?assignments path required}
state_dir=$(dirname -- "$snapshot_file")
snapshot_tmp=$(mktemp "$state_dir/snapshot.XXXXXX")
assignments_tmp=$(mktemp "$state_dir/assignments.XXXXXX")
trap 'rm -f "$snapshot_tmp" "$assignments_tmp"' EXIT

[[ -f $assignments_file ]] || printf '{}\n' >"$assignments_tmp"
old_assignments=$assignments_file
[[ -f $old_assignments ]] || old_assignments=$assignments_tmp

mapfile -t results < <(jq -cn \
  --slurpfile snapshot "$snapshot_file" \
  --slurpfile old "$old_assignments" '
  "asdfghjklqwertyuiopzxcvbnm" | split("") as $keys
  | ($snapshot[0].windows | map(.stableId)) as $visible
  | ($snapshot[0].liveWindowIds // []) as $all_clients
  | (reduce ($visible + $all_clients)[] as $id
      ([]; if index($id) == null then . + [$id] else . end)) as $live
  | (if ($visible | length) <= ($keys | length)
      then $keys
      else [$keys[] as $first | $keys[] as $second | $first + $second]
    end) as $hints
  | ($old[0] // {}) as $previous
  | (reduce $visible[] as $id
      ({ assignments: {}, used: [] };
        ($previous[$id] // "") as $hint
        | if (($hints | index($hint)) != null and (.used | index($hint)) == null)
          then .assignments[$id] = $hint | .used += [$hint]
          else .
          end)) as $preserved
  | (reduce $visible[] as $id
      ($preserved;
        if .assignments[$id] then .
        else .used as $used
          | ([ $hints[] as $candidate
               | select(($used | index($candidate)) == null)
               | $candidate ] | .[0]) as $hint
          | if $hint == null then .
            else .assignments[$id] = $hint | .used += [$hint]
            end
        end)) as $result
  | (reduce $live[] as $id
      ($result.assignments;
        if has($id) then .
        elif (($previous[$id] // "") | length) > 0
        then .[$id] = $previous[$id]
        else .
        end)) as $remembered
  | ({
      assignments: $remembered,
      snapshot: ($snapshot[0]
        | .windows |= map(. + { hint: $result.assignments[.stableId] })
        | .windows |= map(select(.hint != null)))
    }) as $bundle
  | $bundle.snapshot, $bundle.assignments
')

(( ${#results[@]} == 2 )) || exit 1
printf '%s\n' "${results[0]}" >"$snapshot_tmp"
printf '%s\n' "${results[1]}" >"$assignments_tmp"
mv -f "$snapshot_tmp" "$snapshot_file"
mv -f "$assignments_tmp" "$assignments_file"
