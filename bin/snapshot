#!/usr/bin/env bash

set -euo pipefail

# Keep all geometry in Hyprland's logical coordinate space. Quickshell's
# per-output PanelWindows use the same logical dimensions, including on
# fractionally scaled displays.
jq -s '
  .[0] as $raw_monitors
  | ($raw_monitors | map({
      name,
      x,
      y,
      width: (.width / .scale | round),
      height: (.height / .scale | round),
      focused,
      activeWorkspace,
      specialWorkspace
    })) as $monitors
  | .[1] as $clients
  | ($monitors
      | map(.specialWorkspace.id)
      | map(select(. != 0))
      | unique) as $visible_special_workspaces
  | ($clients
      | map(select((.address // "") != "" and (.stableId // "") != ""))
      | map({ key: .address, value: .stableId })
      | from_entries) as $stable_by_address
  | def hint_id:
      if ((.grouped // []) | length) > 0 then
        "group:" + ([.grouped[] | $stable_by_address[.] // empty] | sort | join("+"))
      else .stableId
      end;
  {
      monitors: $monitors,
      liveWindowIds: ($clients
        | map(select(.mapped == true and (.stableId // "") != ""))
        | map([hint_id, .stableId])
        | flatten
        | unique),
      windows: (
        $clients
        | map(select(.mapped == true and .hidden == false))
        | map(select(
            .workspace.id as $workspace
            | if ($visible_special_workspaces | length) > 0 then
                any($visible_special_workspaces[]; . == $workspace)
              else
                .pinned == true
                or any($monitors[].activeWorkspace.id; . == $workspace)
              end
          ))
        | map(. + { hintId: hint_id })
        | group_by(.hintId)
        | map(sort_by(.focusHistoryID) | .[0])
        | map(. as $client
            | (($client.at[0] + ($client.size[0] / 2)) | floor) as $center_x
            | (($client.at[1] + ($client.size[1] / 2)) | floor) as $center_y
            | ($monitors
                | map(select(
                    $center_x >= .x and $center_x < (.x + .width)
                    and $center_y >= .y and $center_y < (.y + .height)))
                | .[0]) as $monitor
            | select($monitor != null)
            | {
                address,
                stableId,
                hintId,
                at,
                size,
                class,
                title,
                monitor: $monitor.name,
                focused: (.focusHistoryID == 0)
              })
        | sort_by(.monitor, .at[1], .at[0])
        | .[0:676]
      )
    }
' <(hyprctl -j monitors) <(hyprctl -j clients)
